{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLPE",
  "version": "0.1.0",
  "identifier": "uz.clpe.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CLPE — Cyber Range",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#05080d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; frame-src https://www.youtube.com https://player.vimeo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "category": "Education",
    "shortDescription": "Cybersecurity Learning & Practice Environment",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] } },
    "windows": { "wix": { "language": ["en-US"] } }
  }
}
