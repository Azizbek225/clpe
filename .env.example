# Muhim: production'da albatta o'zgartiring
CLPE_SECRET_KEY=change-me-to-a-long-random-string
CLPE_FLAG_PEPPER=change-me-too
CLPE_SEED_ADMIN_EMAIL=admin@clpe.local
CLPE_SEED_ADMIN_PASSWORD=Admin12345!
POSTGRES_PASSWORD=clpe

# Lab Engine: mock | docker | virtualbox | libvirt
CLPE_LAB_PROVIDER=docker
CLPE_MAX_ACTIVE_LABS_PER_USER=2
CLPE_ALLOW_INTERNET_LABS=false
CLPE_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# Plaginlar (yangi validator/provider modullari), JSON ro'yxat
CLPE_PLUGIN_MODULES=[]
